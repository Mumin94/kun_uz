@baseUrl = http://localhost:8080/api/v1
@resource = categories
@id = 1

### Create category - expect 201
POST {{baseUrl}}/{{resource}}
Content-Type: application/json

{
  "orderNumber": 1,
  "nameUz": "O‘zbekiston",
  "nameRu": "Узбекистан",
  "nameEn": "Uzbekistan"
}

### Get category by ID - expect 200
GET {{baseUrl}}/{{resource}}/{{id}}

### Update category - expect 200
PUT {{baseUrl}}/{{resource}}/{{id}}
Content-Type: application/json

{
  "orderNumber": 2,
  "nameUz": "Jahon",
  "nameRu": "Мир",
  "nameEn": "World"
}

### Get paginated categories - expect 200
GET {{baseUrl}}/{{resource}}?page=1&size=10

### Get with default pagination - expect 200
GET {{baseUrl}}/{{resource}}

### Create with invalid fields - expect 400
POST {{baseUrl}}/{{resource}}
Content-Type: application/json

{
  "orderNumber": 0,
  "nameUz": "",
  "nameRu": "Тест",
  "nameEn": "Test"
}

### Get with invalid page - expect 400
GET {{baseUrl}}/{{resource}}?page=0&size=10

### Get with invalid size - expect 400
GET {{baseUrl}}/{{resource}}?page=1&size=0

### Get with size above limit - expect 400
GET {{baseUrl}}/{{resource}}?page=1&size=101

### Soft delete category - expect 204
DELETE {{baseUrl}}/{{resource}}/{{id}}

### Get deleted category - expect 404
GET {{baseUrl}}/{{resource}}/{{id}}

### List after deletion - expect deleted category excluded
GET {{baseUrl}}/{{resource}}?page=1&size=10

### Delete already deleted category - expect 404
DELETE {{baseUrl}}/{{resource}}/{{id}}

### Categories in English, ordered by display order
GET http://localhost:8080/api/v1/categories/lang?language=EN