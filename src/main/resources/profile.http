@baseUrl = http://localhost:8080/api/v1/profiles
@id = 1

### Create profile - expect 201, no password in response
POST {{baseUrl}}
Content-Type: application/json

{
  "name": "Jhone",
  "surname": "Doe",
  "email": "jd@example.com",
  "phone": "+998907771171",
  "password": "TestPassword124!",
  "status": "ACTIVE",
  "role": "MODERATOR"
}

### Get profile by ID - expect 200
GET {{baseUrl}}/{{id}}

### Update with unchanged email and phone - expect 200
PUT {{baseUrl}}/{{id}}
Content-Type: application/json

{
  "name": "James",
  "surname": "Anderson",
  "email": "james.wilson@example.com",
  "phone": "+998901234567",
  "status": "ACTIVE",
  "role": "MODERATOR"
}

### Create with duplicate email - expect 409
POST {{baseUrl}}
Content-Type: application/json

{
  "name": "Emma",
  "surname": "Taylor",
  "email": "james.wilson@example.com",
  "phone": "+998901234568",
  "password": "TestPassword123!",
  "status": "ACTIVE",
  "role": "USER"
}

### Create with duplicate phone - expect 409
POST {{baseUrl}}
Content-Type: application/json

{
  "name": "Emma",
  "surname": "Taylor",
  "email": "emma.taylor@example.com",
  "phone": "+998901234567",
  "password": "TestPassword123!",
  "status": "ACTIVE",
  "role": "USER"
}

### Create second profile - expect 201
POST {{baseUrl}}
Content-Type: application/json

{
  "name": "Emma",
  "surname": "Taylor",
  "email": "emma.taylor@example.com",
  "phone": "+998901234568",
  "password": "TestPassword123!",
  "status": "ACTIVE",
  "role": "USER"
}

### Update using another profile's email - expect 409
PUT {{baseUrl}}/{{id}}
Content-Type: application/json

{
  "name": "James",
  "surname": "Anderson",
  "email": "emma.taylor@example.com",
  "phone": "+998901234567",
  "status": "ACTIVE",
  "role": "MODERATOR"
}

### Update using another profile's phone - expect 409
PUT {{baseUrl}}/{{id}}
Content-Type: application/json

{
  "name": "James",
  "surname": "Anderson",
  "email": "james.wilson@example.com",
  "phone": "+998901234568",
  "status": "ACTIVE",
  "role": "MODERATOR"
}

### Get paginated profiles - expect 200, newest first
GET {{baseUrl}}?page=1&size=10

### Get with default pagination - expect 200
GET {{baseUrl}}

### Create with invalid fields - expect 400
POST {{baseUrl}}
Content-Type: application/json

{
  "name": "",
  "surname": "Wilson",
  "email": "invalid-email",
  "phone": "12345",
  "password": "123",
  "status": null,
  "role": null
}

### Get with invalid page - expect 400
GET {{baseUrl}}?page=0&size=10

### Get with invalid size - expect 400
GET {{baseUrl}}?page=1&size=0

### Get with size above limit - expect 400
GET {{baseUrl}}?page=1&size=101

### Soft delete profile - expect 204
DELETE {{baseUrl}}/{{id}}

### Get deleted profile - expect 404
GET {{baseUrl}}/{{id}}

### List after deletion - deleted profile excluded
GET {{baseUrl}}?page=1&size=10

### Delete already deleted profile - expect 404
DELETE {{baseUrl}}/{{id}}

### Reuse deleted profile's email - expect 409
POST {{baseUrl}}
Content-Type: application/json

{
  "name": "Oliver",
  "surname": "Brown",
  "email": "james.wilson@example.com",
  "phone": "+998901234569",
  "password": "TestPassword123!",
  "status": "ACTIVE",
  "role": "USER"
}